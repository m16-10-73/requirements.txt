from datetime import datetime
import json
import os


class BitacoraDinamica:

    def __init__(self, nombre_archivo, capital_inicial_default):
        self.archivo = nombre_archivo
        self.capital_default = capital_inicial_default
        self.estado = self.cargar_estado()

    def cargar_estado(self):
        # 1. Al iniciar: busca el archivo en disco.
        if os.path.exists(self.archivo):
            try:
                with open(self.archivo, "r", encoding="utf-8") as f:
                    datos = json.load(f)
                    # Lee el capital acumulado real de la sesión anterior
                    return datos
            except Exception:
                pass

        # Si no existe el archivo (primer día), arranca con el capital base original
        return {
            "capital_inicial": self.capital_default,
            "ganancia_cerrada": 0.0,
            "posiciones": [],
            "peak_flotante": 0.0,
            "historial_rendimiento": [
                {
                    "Fecha": datetime.now().strftime("%d/%m/%Y"),
                    "Capital": self.capital_default,
                }
            ],
        }

    def guardar_cierre_jornada(
        self, nuevo_capital, posiciones, peak, rendimiento
    ):
        # 2. Al cerrar jornada: toma el capital viejo + ganancias,
        # y sobreescribe el JSON con este NUEVO capital base acumulado.
        self.estado = {
            "capital_inicial": nuevo_capital,  # <-- ¡Aquí ocurre la magia de la acumulación!
            "ganancia_cerrada": 0.0,
            "posiciones": posiciones,
            "peak_flotante": peak,
            "historial_rendimiento": rendimiento,
        }
        try:
            with open(self.archivo, "w", encoding="utf-8") as f:
                json.dump(self.estado, f, ensure_ascii=False, indent=4)
        except Exception as e:
            print(f"Error al guardar la bitácora: {e}")

    def obtener(self, clave):
        return self.estado.get(clave, None)
